rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the 6 accounts created by admin.py carry the "family" claim.
    function isFamily() {
      return request.auth != null && request.auth.token.family == true;
    }

    match /users/{uid} {
      allow read: if isFamily();
      allow update: if isFamily() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmTokens', 'lastSeen']);

      // Personal settings (e.g. own names for contacts): visible to the owner only.
      match /private/{doc} {
        allow read, write: if isFamily() && request.auth.uid == uid;
      }
    }

    match /chats/{chatId} {
      allow read: if isFamily() && (resource == null || request.auth.uid in resource.data.members);
      allow create: if isFamily() && request.auth.uid in request.resource.data.members;
      allow update: if isFamily() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{messageId} {
        function inChat() {
          return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        allow read: if isFamily() && inChat();
        // getAfter: the first message of a direct chat is written in the same batch that creates the chat.
        allow create: if isFamily() && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow delete: if isFamily() && resource.data.senderId == request.auth.uid;
      }
    }
  }
}
